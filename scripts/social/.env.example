# ═══════════════════════════════════════════════════════
# scripts/social — nümunə konfiqurasiya (Qaraçuxur Məscidi Instagram avtoposteri)
#
# Serverdə bu faylı .env kimi kopyala və dəyərləri doldur:
#   cp .env.example .env && nano .env
# .env git-ə DÜŞMÜR (bax .gitignore) — açarları ora yaz.
# ═══════════════════════════════════════════════════════

# ── Claude (caption üçün) ──
# console.anthropic.com → API Keys
# Boş qoyulsa sistem işləməyə davam edir, sadəcə şablon caption istifadə olunur.
ANTHROPIC_API_KEY=

# ── Instagram Graph API ──
# Qaraçuxur Məscidinin Instagram Business hesabının rəqəm ID-si
IG_USER_ID=
# Uzunömürlü access token (60 gün — bax README "Token yeniləmə")
IG_ACCESS_TOKEN=
# Meta API versiyası. 400 xətası alsan cari versiyanı bura yaz.
IG_API_VERSION=v21.0

# ── Şəkillərin yeri ──
# Instagram şəkli PUBLIC URL-dən oxuyur, ona görə fayl web kökünə yazılmalıdır.
# Domen muslims.cc olaraq qalır.
SOCIAL_PUBLIC_DIR=/var/www/muslims/posts
SOCIAL_PUBLIC_BASE=https://muslims.cc/posts

# ── Python (render.py üçün) ──
# Ubuntu-da adətən python3; virtualenv istifadə edirsənsə tam yolu yaz.
PYTHON_BIN=python3
