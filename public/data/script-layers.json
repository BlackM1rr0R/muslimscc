{"edition":"quran-uthmani","ayahs":[{"ref":"1:1","surah":1,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"ref":"1:2","surah":1,"ayah":2,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"},{"ref":"1:3","surah":1,"ayah":3,"text":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"ref":"1:4","surah":1,"ayah":4,"text":"مَٰلِكِ يَوْمِ ٱلدِّينِ"},{"ref":"1:5","surah":1,"ayah":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"},{"ref":"1:6","surah":1,"ayah":6,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"},{"ref":"1:7","surah":1,"ayah":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"},{"ref":"112:1","surah":112,"ayah":1,"text":"قُلْ هُوَ ٱللَّهُ أَحَدٌ"},{"ref":"112:2","surah":112,"ayah":2,"text":"ٱللَّهُ ٱلصَّمَدُ"},{"ref":"112:3","surah":112,"ayah":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},{"ref":"112:4","surah":112,"ayah":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"}]}