# ═══════════════════════════════════════════════════════
# Muslims.cc — Apache konfiqurasiyası (cPanel / adi hostinq)
#
# Canlı sayt Docker + nginx-dədir (infra/). Bu fayl yalnız FTP ilə adi hostinqə
# yüklənəndə marşrutlaşdırmanı idarə edir.
#
# public/ qovluğundadır, ona görə build zamanı avtomatik dist/-ə düşür.
# ═══════════════════════════════════════════════════════

Options -MultiViews
DirectorySlash Off

# ── Həqiqi 404 ──
# Naməlum ünvan (/nope, /ru/nope) ana səhifəni 200 ilə YOX, 404.html-i
# HTTP 404 statusu ilə alır. 404.html-i build (scripts/prerender.mjs) yazır:
# SPA qabığıdır, brauzerdə "Səhifə tapılmadı" səhifəsini URL-in dilində
# göstərir, noindex-dir. Kök-nisbi yol (/404.html) — status 404 qalır;
# tam URL (https://...) yazsan Apache 302 yönləndirmə edərdi.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── HTTPS-ə yönləndir ──
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ── www-suz kanonik domen ──
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ── /az/... → prefiksiz kanonik forma ──
  # Azərbaycan dili prefiksizdir (/quran); /az/quran üçün statik fayl yoxdur.
  # Tətbiq bu ünvanı tanıyır, ona görə 404 yox, 301: /az → /, /az/quran → /quran
  RewriteRule ^az(?:/(.*))?$ /$1 [R=301,L]

  # ── Silinmiş /mosque səhifəsi → eyni dildə /about ──
  # 2026-09 — 2026-10 arası saytda "Məscid haqqında" (/mosque) səhifəsi var idi;
  # sayt yenidən ümumi platforma olanda silindi. 301 — Google köhnə URL-in
  # yerinə "Haqqımızda"-nı indeksləsin (404 olsa, qazanılmış keçidlər itərdi).
  # /mosques (yaxınlıqdakı məscidlər) bu qaydaya düşmür: sonda "/?$" var.
  RewriteRule ^mosque/?$ /about [R=301,L]
  RewriteRule ^(en|ru|ar|tr)/mosque/?$ /$1/about [R=301,L]

  # ── Sondakı "/" -i sil ──
  # /quran/ və /quran ayrı-ayrı indekslənməsin deyə tək forma saxlanılır
  # (canonical teqləri də prefikssiz formanı göstərir).
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)/$ /$1 [R=301,L]

  # ── Qısa surə ünvanı /quran/<n> → kanonik /quran/<n>-<slug> (301) ──
  # BEGIN quran-redirects
  # (scripts/gen-quran-redirects.mjs yaradır — əl ilə redaktə etmə) /quran/<n>, /<dil>/quran/<n> → 301 /quran/<n>-<slug> (nginx: map $quran_slug)
  RewriteRule ^((?:[a-z]{2}/)?)quran/1$ /$1quran/1-al-faatiha [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/2$ /$1quran/2-al-baqara [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/3$ /$1quran/3-aal-i-imraan [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/4$ /$1quran/4-an-nisaa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/5$ /$1quran/5-al-maaida [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/6$ /$1quran/6-al-anaam [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/7$ /$1quran/7-al-araaf [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/8$ /$1quran/8-al-anfaal [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/9$ /$1quran/9-at-tawba [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/10$ /$1quran/10-yunus [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/11$ /$1quran/11-hud [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/12$ /$1quran/12-yusuf [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/13$ /$1quran/13-ar-rad [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/14$ /$1quran/14-ibrahim [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/15$ /$1quran/15-al-hijr [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/16$ /$1quran/16-an-nahl [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/17$ /$1quran/17-al-israa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/18$ /$1quran/18-al-kahf [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/19$ /$1quran/19-maryam [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/20$ /$1quran/20-taa-haa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/21$ /$1quran/21-al-anbiyaa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/22$ /$1quran/22-al-hajj [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/23$ /$1quran/23-al-muminoon [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/24$ /$1quran/24-an-noor [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/25$ /$1quran/25-al-furqaan [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/26$ /$1quran/26-ash-shuaraa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/27$ /$1quran/27-an-naml [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/28$ /$1quran/28-al-qasas [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/29$ /$1quran/29-al-ankaboot [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/30$ /$1quran/30-ar-room [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/31$ /$1quran/31-luqman [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/32$ /$1quran/32-as-sajda [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/33$ /$1quran/33-al-ahzaab [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/34$ /$1quran/34-saba [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/35$ /$1quran/35-faatir [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/36$ /$1quran/36-yaseen [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/37$ /$1quran/37-as-saaffaat [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/38$ /$1quran/38-saad [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/39$ /$1quran/39-az-zumar [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/40$ /$1quran/40-ghafir [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/41$ /$1quran/41-fussilat [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/42$ /$1quran/42-ash-shura [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/43$ /$1quran/43-az-zukhruf [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/44$ /$1quran/44-ad-dukhaan [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/45$ /$1quran/45-al-jaathiya [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/46$ /$1quran/46-al-ahqaf [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/47$ /$1quran/47-muhammad [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/48$ /$1quran/48-al-fath [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/49$ /$1quran/49-al-hujuraat [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/50$ /$1quran/50-qaaf [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/51$ /$1quran/51-adh-dhaariyat [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/52$ /$1quran/52-at-tur [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/53$ /$1quran/53-an-najm [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/54$ /$1quran/54-al-qamar [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/55$ /$1quran/55-ar-rahmaan [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/56$ /$1quran/56-al-waaqia [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/57$ /$1quran/57-al-hadid [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/58$ /$1quran/58-al-mujaadila [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/59$ /$1quran/59-al-hashr [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/60$ /$1quran/60-al-mumtahana [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/61$ /$1quran/61-as-saff [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/62$ /$1quran/62-al-jumua [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/63$ /$1quran/63-al-munaafiqoon [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/64$ /$1quran/64-at-taghaabun [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/65$ /$1quran/65-at-talaaq [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/66$ /$1quran/66-at-tahrim [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/67$ /$1quran/67-al-mulk [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/68$ /$1quran/68-al-qalam [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/69$ /$1quran/69-al-haaqqa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/70$ /$1quran/70-al-maaarij [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/71$ /$1quran/71-nooh [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/72$ /$1quran/72-al-jinn [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/73$ /$1quran/73-al-muzzammil [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/74$ /$1quran/74-al-muddaththir [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/75$ /$1quran/75-al-qiyaama [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/76$ /$1quran/76-al-insaan [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/77$ /$1quran/77-al-mursalaat [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/78$ /$1quran/78-an-naba [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/79$ /$1quran/79-an-naaziaat [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/80$ /$1quran/80-abasa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/81$ /$1quran/81-at-takwir [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/82$ /$1quran/82-al-infitaar [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/83$ /$1quran/83-al-mutaffifin [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/84$ /$1quran/84-al-inshiqaaq [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/85$ /$1quran/85-al-burooj [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/86$ /$1quran/86-at-taariq [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/87$ /$1quran/87-al-alaa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/88$ /$1quran/88-al-ghaashiya [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/89$ /$1quran/89-al-fajr [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/90$ /$1quran/90-al-balad [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/91$ /$1quran/91-ash-shams [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/92$ /$1quran/92-al-lail [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/93$ /$1quran/93-ad-dhuhaa [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/94$ /$1quran/94-ash-sharh [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/95$ /$1quran/95-at-tin [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/96$ /$1quran/96-al-alaq [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/97$ /$1quran/97-al-qadr [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/98$ /$1quran/98-al-bayyina [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/99$ /$1quran/99-az-zalzala [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/100$ /$1quran/100-al-aadiyaat [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/101$ /$1quran/101-al-qaaria [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/102$ /$1quran/102-at-takaathur [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/103$ /$1quran/103-al-asr [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/104$ /$1quran/104-al-humaza [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/105$ /$1quran/105-al-fil [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/106$ /$1quran/106-quraish [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/107$ /$1quran/107-al-maaun [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/108$ /$1quran/108-al-kawthar [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/109$ /$1quran/109-al-kaafiroon [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/110$ /$1quran/110-an-nasr [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/111$ /$1quran/111-al-masad [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/112$ /$1quran/112-al-ikhlaas [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/113$ /$1quran/113-al-falaq [R=301,L]
  RewriteRule ^((?:[a-z]{2}/)?)quran/114$ /$1quran/114-an-naas [R=301,L]
  # END quran-redirects

  # ── /404.html birbaşa açılanda da 404 ──
  # (200 ilə indekslənə bilən dublikat olmasın). ErrorDocument-in daxili
  # yönləndirməsində REDIRECT_STATUS dolu olur — o zaman fayl adi qaydada verilir.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^404\.html$ - [R=404,L]

  # ── Mövcud fayllar olduğu kimi verilsin (assets, şəkillər, sitemap) ──
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ── Ana səhifə ──
  # Əvvəl "/" aşağıdakı ümumi SPA qaydası ilə açılırdı; o qayda artıq yoxdur.
  RewriteRule ^$ /index.html [L]

  # ── Açıq profil /u/<ləqəb>, /<dil>/u/<ləqəb> → [<dil>/]u/index.html (200; robots-u səhifə özü yazır) ──
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^((?:[a-z]{2}/)?u)/[a-z0-9_]{3,24}$ /$1/index.html [L]

  # ── Prerender edilmiş marşrutlar: /quran → /quran/index.html ──
  # DirectorySlash Off olduğu üçün bunu açıq şəkildə yazmaq lazımdır.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # ── Qalan hər şey — HƏQİQİ 404 (ErrorDocument 404.html-i verir) ──
  # Əvvəl burada "RewriteRule ^ /index.html [L]" idi: hər naməlum ünvan
  # 200 + ana səhifə qaytarırdı ("soft-404"). /api/ istisnadır — onu
  # hostinqdə başqa nə idarə edirsə, ona toxunulmur.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ - [R=404,L]
</IfModule>

# ── Sıxılma ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Keşləmə ──
<IfModule mod_expires.c>
  ExpiresActive On

  # Adında hash olan fayllar — məzmun dəyişəndə ad da dəyişir
  <FilesMatch "\.(js|css|woff2?|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|avif)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # HTML heç vaxt keşlənməsin — deploy dərhal görünsün
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Service worker və sitemap də təzə oxunsun
  <FilesMatch "(sw\.js|sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ── MIME tipləri ──
<IfModule mod_mime.c>
  AddType application/manifest+json  .webmanifest
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
</IfModule>

# ── Təhlükəsizlik başlıqları ──
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
